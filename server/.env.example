NODE_ENV=development
PORT=4000
TZ=Asia/Dhaka

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://store:storepass@localhost:3306/store_manager"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TTL=15m
REFRESH_TTL_DAYS=14

# Origin of the web app (CORS + links in e-mails)
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind nginx / a load balancer
TRUST_PROXY=0

# Where uploaded logos are stored (mount a persistent volume in production)
UPLOAD_DIR=uploads

# Optional SMTP (password reset e-mails). Without it, links are printed to the log in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Store Manager <no-reply@example.com>"

# Used by `npm run seed`
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123
# Set to 1 to also create an approved demo store (owner: demo@example.com / DemoPass123)
SEED_DEMO=0
